# Copy to .dev.vars for local development (.dev.vars is git-ignored).
# Cloudflare's published test key: always passes. Never use it in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
ADMIN_EMAIL=you@example.com
# Skips the admin login, and only when the host is "localhost".
DEV_ADMIN_BYPASS=1
