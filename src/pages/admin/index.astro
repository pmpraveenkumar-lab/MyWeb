---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Enrollments" noindex>
  <h1>Enrollments</h1>
  <p>
    <span id="count">Loading…</span>
    · <a href={`${base}admin/api/enrollments?format=csv`}>Download CSV</a>
  </p>
  <p id="problem" class="error" role="alert" hidden></p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Received</th><th>Name</th><th>Phone</th><th>Email</th></tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>

  <script>
    interface Row { id: number; created_at: string; name: string; phone: string; email: string }

    const rows = document.getElementById('rows')!;
    const count = document.getElementById('count')!;
    const problem = document.getElementById('problem')!;

    try {
      const res = await fetch(`${import.meta.env.BASE_URL}admin/api/enrollments`);
      if (!res.ok) throw new Error(String(res.status));
      const data: Row[] = await res.json();
      count.textContent = `${data.length} enrollment${data.length === 1 ? '' : 's'}`;
      for (const r of data) {
        const tr = document.createElement('tr');
        // textContent only: submitted values are never treated as HTML.
        for (const v of [new Date(r.created_at).toLocaleString(), r.name, r.phone, r.email]) {
          const td = document.createElement('td');
          td.textContent = v;
          tr.append(td);
        }
        rows.append(tr);
      }
    } catch {
      count.textContent = '';
      problem.textContent = 'Could not load enrollments. Are you signed in?';
      problem.hidden = false;
    }
  </script>
</Base>
