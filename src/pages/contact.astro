---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const base = import.meta.env.BASE_URL;
---

<Base title="Contact" description="How to reach us.">
  <h1>Contact</h1>
  <ul>
    <li>Phone: <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
    <li>WhatsApp: <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">Message us</a></li>
    <li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>
    <li>Location: {site.location}</li>
    <li>Hours: {site.hours}</li>
  </ul>
  <p><a class="btn" href={`${base}enroll/`}>Enroll now</a></p>
</Base>
