---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const base = import.meta.env.BASE_URL;
const { batch } = site;
---

<Base title="Programs" description={`Handwriting program: ${batch.duration}, ${batch.schedule}, ${batch.session}.`}>
  <h1>Programs</h1>

  <div class="card">
    <h2>Handwriting training</h2>
    <p>Open for {batch.openFor}.</p>
    <ul>
      <li><strong>Duration:</strong> {batch.duration}</li>
      <li><strong>Schedule:</strong> {batch.schedule}</li>
      <li><strong>Session:</strong> {batch.session}</li>
      <li><strong>Batch size:</strong> {batch.size}</li>
    </ul>
  </div>

  <h2>Fees</h2>
  <p>
    To know the fee structure, please contact the instructor on
    <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
    or <a href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a>.
  </p>

  <p><a class="btn" href={`${base}enroll/`}>Enroll now</a></p>
</Base>
