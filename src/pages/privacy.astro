---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="Privacy policy" description="How enrollment details are used and stored.">
  <h1>Privacy policy</h1>

  <h2>What we collect</h2>
  <p>When you enroll we collect your name, phone number and email address. We collect nothing else on the form.</p>

  <h2>Why</h2>
  <p>Only to contact you about handwriting programs you asked about. We do not sell or share your details.</p>

  <h2>How it is stored</h2>
  <p>
    Your details are stored in a protected database. Only the site owner can view them, after signing in.
    The site runs on Cloudflare, which processes requests on our behalf.
  </p>

  <h2>Your choices</h2>
  <p>
    You can ask us to show, correct or delete your details at any time by writing to
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</Base>
