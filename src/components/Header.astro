---
import { site } from '../site';

const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
---

<header class="container bar">
  <a class="brand" href={base}>{site.name}</a>
  <nav aria-label="Main">
    {
      site.nav.map((l) => (
        <a href={`${base}${l.path}`} aria-current={current === `${base}${l.path}` ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <a class="btn small" href={`${base}enroll/`}>Enroll</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .brand {
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
