---
import { site } from '../site';
---

<aside class="approach">
  <h2>{site.approach.heading}</h2>
  <p>{site.approach.text}</p>
</aside>

<style>
  .approach {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--accent);
    background: var(--card);
    text-align: left;
  }
  .approach h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
  .approach p {
    margin: 0;
    color: var(--muted);
  }
</style>
