/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Cloudflare Pages adds "Access-Control-Allow-Origin: *" by default. Harmless on public
# pages/assets, but the API and booking-redirect responses should not declare themselves
# fetchable cross-origin at all. The unset syntax is "! Header-Name" as its own line,
# not "Header-Name: !" (which just sets the literal string "!" as the value).
/api/*
  ! Access-Control-Allow-Origin
/admin/api/*
  ! Access-Control-Allow-Origin
/book-session
  ! Access-Control-Allow-Origin
